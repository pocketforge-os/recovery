#!/usr/bin/env bash
# Build 8 A133 sun8i-rotate collector. Bulk input arrives on the FAT payload.
set -euo pipefail

MODE=${1:-}
OUT=${2:-/run/pf-g2d/result}
ROOT=${PF_G2D_ROOT:-/run/pf-g2d}
HELPER=${PF_G2D_HELPER:-$ROOT/pf-v4l2-rotate}
PARSER=${PF_G2D_PARSER:-$ROOT/g2d-parser.py}
OBSERVER=${PF_G2D_OBSERVER:-$ROOT/pf-output-observe.so}
DIAGNOSE=${PF_G2D_DIAGNOSE:-$ROOT/g2d-diagnose.py}
NODE=${PF_G2D_NODE:-}
DIAG_DIR=

fail() {
    if [[ -n "$DIAG_DIR" ]]; then
        diagnostic_rc=0
        "$PARSER" failure-diagnostics "$DIAG_DIR" || diagnostic_rc=$?
        if [[ "$diagnostic_rc" != 0 ]]; then
            printf 'G2D_DIAG state=unavailable rc=%s\n' "$diagnostic_rc"
        fi
    fi
    printf 'G2D_RESULT state=fail stage=%s reason=%s\n' "$1" "$2"
    exit 1
}
field() { "$PARSER" receipt-field "$1" "$2"; }

case "$MODE" in
  run|score) ;;
  *) echo 'usage: g2d-dut run|score OUTPUT_DIR' >&2; exit 2 ;;
esac

if [[ "$MODE" == run ]]; then
    [[ -x "$HELPER" && -x "$PARSER" ]] || fail preflight helper_missing
    [[ "$OBSERVER" == disabled || -r "$OBSERVER" ]] || fail preflight observer_missing
    if [[ -z "$NODE" ]]; then
        printf '%s\n' 'G2D_ENUM_PROBE command=for n in /dev/video[0-9]*; do test -e "$n" || continue; printf "G2D_ENUM_NODE node=%s\\n" "$n"; v4l2-ctl --info --device "$n" 2>&1 | sed -n "1,40p"; done'
        count=0
        for candidate in /dev/video[0-9]*; do
            [[ -e "$candidate" ]] || continue
            info=$(mktemp /run/pf-g2d-v4l2.XXXXXX)
            producer_rc=0
            v4l2-ctl --info --device "$candidate" >"$info" 2>&1 || producer_rc=$?
            if [[ "$producer_rc" == 0 ]]; then
                parser_rc=0
                driver=$("$PARSER" v4l2-driver "$info") || parser_rc=$?
                if [[ "$parser_rc" == 0 ]]; then
                    printf 'G2D_ENUM node=%s state=parsed driver=%s\n' "$candidate" "$driver"
                    if [[ "$driver" == sun8i-rotate ]]; then
                        count=$((count + 1))
                        NODE=$candidate
                    fi
                else
                    printf 'G2D_ENUM node=%s state=parse_failed rc=%s\n' "$candidate" "$parser_rc"
                fi
            else
                printf 'G2D_ENUM node=%s state=producer_failed rc=%s\n' "$candidate" "$producer_rc"
            fi
            find "$info" -maxdepth 0 -type f -delete
        done
        [[ "$count" == 1 ]] || fail enumerate "node_count_$count"
    fi
    [[ ! -e "$OUT" ]] || { find "$OUT" -mindepth 1 -delete; rmdir "$OUT"; }
    mkdir -p "$OUT/rotate" "$OUT/probe"
    : >"$OUT/helper.stdout"
    : >"$OUT/helper.stderr"
    : >"$OUT/v4l2-compliance.txt"
    DIAG_DIR=$OUT
    compliance_rc=0
    v4l2-compliance -d "$NODE" >"$OUT/v4l2-compliance.txt" 2>&1 \
      || compliance_rc=$?
    [[ "$compliance_rc" == 0 ]] || fail compliance "rc_$compliance_rc"
    if [[ "$OBSERVER" != disabled ]]; then
        probe_rc=0
        env LD_PRELOAD="$OBSERVER" PF_OUTPUT_OBSERVE_V4L2_CAPTURE=1 \
          PF_OUTPUT_OBSERVE_EXIT_AFTER_REPORT=1 PF_OUTPUT_OBSERVE_TRACE_IOCTL=1 \
          PF_OUTPUT_OBSERVE_POLL_DEADLINE_MS=2000 \
          PF_OUTPUT_OBSERVE_FILE="$OUT/probe/output-observe.txt" \
          timeout -s TERM -k 2 10 "$HELPER" --device "$NODE" --out "$OUT/probe/rotate" \
          >"$OUT/probe.stdout" 2>"$OUT/probe.stderr" || probe_rc=$?
        "$DIAGNOSE" helper-trace "$OUT/probe.stderr" | tee "$OUT/probe-trace.txt"
        "$DIAGNOSE" job-outcome "$OUT/probe.stderr" | tee "$OUT/job-outcome.txt"
        [[ "$probe_rc" == 98 ]] || fail first-job "rc_$probe_rc"
        grep -Fx 'G2D_JOB case=identity frames=1 outcome=completed elapsed_ms=' "$OUT/job-outcome.txt" >/dev/null 2>&1 \
          || grep -Eq '^G2D_JOB case=identity frames=1 outcome=completed elapsed_ms=[0-9]+$' "$OUT/job-outcome.txt" \
          || fail first-job outcome_not_completed
        [[ -s "$OUT/probe/output-observe.txt" ]] || fail first-job observation_missing
        head -c 1024 "$OUT/probe/output-observe.txt"
        printf 'G2D_RESULT state=pass scope=single_identity_job node=%s\n' "$NODE"
        exit 0
    fi
    # Post-merge acceptance disables the one-job observer and runs the real
    # helper's complete transform matrix before scoring every output locally.
    helper_rc=0
    "$HELPER" --device "$NODE" --out "$OUT/rotate" \
      >"$OUT/helper.stdout" 2>"$OUT/helper.stderr" || helper_rc=$?
    if [[ -s "$OUT/output-observe.txt" ]]; then head -c 1024 "$OUT/output-observe.txt"; fi
    [[ "$helper_rc" == 0 ]] || fail helper "rc_$helper_rc"
fi
if [[ -z "$DIAG_DIR" && -f "$OUT/helper.stderr" \
      && -f "$OUT/helper.stdout" && -f "$OUT/v4l2-compliance.txt" ]]; then
    DIAG_DIR=$OUT
fi

receipt=$OUT/rotate/rotate-receipt.tsv
[[ -s "$receipt" ]] || fail score receipt_missing
[[ "$(field "$receipt" result)" == pass ]] || fail score receipt_failed

rows=(
  'identity 0 0 0 400f6764a2ad1444c9e6fbea5099299b89f896cd80d972ce2268169123c757c1'
  'rotate90 90 0 0 fea6a8a80ca5aa9c00f1eb01692429097240ff61510d60639d49989d05e4a30c'
  'rotate180 180 0 0 f719cf18c4304cf6b1d65157a3b766db4e8bfaa4973c54700ff48bbef3449722'
  'rotate270 270 0 0 7189437156a840026767e42e99813e05d3371b0176222be57638ab82657af821'
  'hflip 0 1 0 16332969ee340c7db1aad9cb8b7a40dd759ffd9e0df8f3c46b8ddd0ba1fb0183'
  'vflip 0 0 1 15da1cffb6ca960e8b694a613da497201c9ea0c89893a0c1b38f766213342bd3'
  'hvflip 0 1 1 f719cf18c4304cf6b1d65157a3b766db4e8bfaa4973c54700ff48bbef3449722'
)
for row in "${rows[@]}"; do
    read -r name angle hf vf reference_sha <<<"$row"
    mismatches=$(field "$receipt" "${name}_mismatches")
    [[ "$mismatches" == 0 ]] || fail score "${name}_mismatches_$mismatches"
    output_sha=$(sha256sum "$OUT/rotate/$name.xrgb" | awk '{print $1}')
    [[ "$output_sha" == "$reference_sha" ]] || fail score "${name}_checksum_mismatch"
    printf 'G2D_ROTATION format=XRGB8888 angle=%s hflip=%s vflip=%s result=pass mismatches=0 output_sha256=%s reference_sha256=%s checksum_match=1\n' \
      "$angle" "$hf" "$vf" "$output_sha" "$reference_sha"
done
printf 'G2D_PERF samples=%s median_us=%s p95_us=%s max_us=%s errors=%s throughput_mib_s=%s\n' \
  "$(field "$receipt" latency_samples)" "$(field "$receipt" latency_median_us)" \
  "$(field "$receipt" latency_p95_us)" "$(field "$receipt" latency_max_us)" \
  "$(field "$receipt" latency_errors)" "$(field "$receipt" throughput_mib_s)"
printf 'G2D_RESULT state=pass format=XRGB8888 transforms=7 checksum_matches=7 node=%s\n' "${NODE:-score-only}"
